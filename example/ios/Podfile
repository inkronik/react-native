ws_dir = Pathname.new(__dir__)
ws_dir = ws_dir.parent until
  File.exist?("#{ws_dir}/node_modules/react-native-test-app/test_app.rb") ||
  ws_dir.expand_path.to_s == '/'
require "#{ws_dir}/node_modules/react-native-test-app/test_app.rb"

workspace 'InkronikNativeCrashHarness.xcworkspace'

use_test_app!(
  :hermes_enabled => true,
  :fabric_enabled => true,
  :post_install => proc do |installer|
    minimum_ios_version = Gem::Version.new(min_ios_version_supported)
    # CocoaPods owns these mutable build settings. Match this app's React Native floor,
    # while keeping the SDK podspec's separate deployment minimum unchanged.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |configuration|
        deployment_target = configuration.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        next unless deployment_target && Gem::Version.new(deployment_target) < minimum_ios_version

        configuration.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = minimum_ios_version.to_s
      end
    end
  end
)
